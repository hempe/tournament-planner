{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "tournament-planner-ui": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "flavors/elfaro/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                // Raw size; the initial transfer size is ~133 kB (measured 2026-11-21, 531 kB raw).
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            // Club flavours (frontend/flavors/<name>): combine with production/development, e.g. -c production,amigos
            "elfaro": {
              "index": "flavors/elfaro/index.html",
              "assets": [{ "glob": "**/*", "input": "flavors/elfaro/assets" }],
              "styles": ["src/styles.css", "flavors/elfaro/theme.css"]
            },
            "amigos": {
              "index": "flavors/amigos/index.html",
              "assets": [{ "glob": "**/*", "input": "flavors/amigos/assets", "ignore": [".gitkeep"] }],
              "styles": ["src/styles.css", "flavors/amigos/theme.css"],
              "fileReplacements": [
                { "replace": "src/app/core/flavor/active-flavor.ts", "with": "src/app/core/flavor/active-flavor.amigos.ts" }
              ]
            }
          },
          "defaultConfiguration": "production,elfaro"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "tournament-planner-ui:build:production,elfaro"
            },
            "development-elfaro": {
              "buildTarget": "tournament-planner-ui:build:development,elfaro"
            },
            "development-amigos": {
              "buildTarget": "tournament-planner-ui:build:development,amigos"
            }
          },
          "defaultConfiguration": "development-elfaro",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  }
}
